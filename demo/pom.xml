<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父工程：依赖版本都由它管，我们不用写版本号 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.campus</groupId>
    <artifactId>campus-rag</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>campus-rag</name>
    <description>校园规章制度智能问答系统</description>

    <properties>
        <java.version>21</java.version>
        <!-- Tika 版本：3.x 是当前稳定线，4.x 太新、中文资料少 -->
        <tika.version>3.3.3</tika.version>
    </properties>

    <dependencies>
        <!-- Web：自带内嵌 Tomcat + Spring MVC，能写 REST 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 指标与健康检查：/actuator/health 公开，/actuator/prometheus 仅管理员 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <!-- 参数校验：@Valid + jakarta.validation 注解，缺它 @Valid 不生效 -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- JDBC：Spring 帮你管数据库连接池 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Redis：用来做问答结果缓存、embedding 缓存和接口限流。
          为什么是 spring-boot-starter-data-redis 而不是 jedis？Boot 默认带 Lettuce（基于 Netty，
          连接复用更好、支持异步），而且零配置就能拿到 StringRedisTemplate。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!--
          Apache Tika：文档解析库。给它一个 PDF/Word 的字节流，它把里面的文字抠出来。
          为什么不用 PDFBox 自己写？因为除了 PDF 还有 docx、doc、甚至 ppt，
          Tika 一个入口全包了（它会自己判断文件真实类型，不看扩展名）。
        -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-pdf-module</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parser-microsoft-module</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- 测试：JUnit 5 + Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 能把项目打成可执行 jar（java -jar 就能跑） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
